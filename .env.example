# Copy to .env (or .env.local), never commit it, and fill in.

# ── For the Supabase CLI (npm run db:push / auth:push / env:keys) ──
# Personal access token: supabase.com/dashboard/account/tokens → Generate new token
# (optional: or run `npx supabase login` once instead and leave this empty)
SUPABASE_ACCESS_TOKEN=
# Project ref: Project Settings → General → Project ID (also in the dashboard URL)
SUPABASE_PROJECT_REF=
# The database password you set when creating the project (Project Settings → Database to reset)
SUPABASE_DB_PASSWORD=

# ── For Google sign-in (npm run auth:push) ──
# Google Cloud → Google Auth Platform → Clients → your Web client
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── For the app (npm run env:keys fills these automatically) ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
