# Copy to .env (or .env.local), never commit it, and fill in.
# SECRETS MUST NOT START WITH NEXT_PUBLIC_ : Next.js ships NEXT_PUBLIC_* values to every browser.

# ── Supabase CLI (npm run db:push / auth:push / env:keys) ──
# Personal access token (optional: or run `npx supabase login` once)
SUPABASE_ACCESS_TOKEN=
# Project Settings → General → Project ID
SUPABASE_PROJECT_REF=
# Database password (Project Settings → Database to reset)
SUPABASE_DB_PASSWORD=

# ── Google sign-in (npm run auth:push) ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── App, public (npm run env:keys fills these) ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ── Server only: natural-language logging (/api/food/parse) ──
# Supabase secret key (Project Settings → API Keys → Secret keys). Service role: bypasses RLS.
SUPABASE_SECRET_KEY=
OPENAI_API_KEY=
# Optional overrides
# NL_MODEL=gpt-6-luna
# NL_PARSE_PER_MINUTE=10
# NL_PARSE_PER_DAY=200

# ── Server only: gym place search (/api/places/search, D37) ──
# geoapify.com → sign up → create a project → API key (free: 3,000 requests/day, commercial use OK).
# Without it, search says "not set up" and the map + current location still work.
GEOAPIFY_API_KEY=
# Optional overrides
# PLACES_PER_MINUTE=30
# PLACES_PER_DAY=300

# ── Server only: admin panel (/admin, D51) ──
# Comma-separated Google account emails allowed into the admin panel. Empty = nobody.
ADMIN_EMAILS=
